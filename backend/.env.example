APP_NAME=ToxiCheck API
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://toxicheck:toxicheck@localhost:5432/toxicheck
# Catalog v2: used by the API (read-only) and explicit catalog imports.
# In Railway: ${{Postgres-hcbk.DATABASE_URL}}. Empty falls back to DATABASE_URL.
TOXICHECK_CATALOG_DATABASE_URL=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OCR_MODE=embedded
# OCR_SERVICE_URL is needed only for OCR_MODE=http.
OCR_SERVICE_URL=
