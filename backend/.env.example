APP_NAME=ToxiCheck API
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://toxicheck:toxicheck@localhost:5433/toxicheck
# Catalog v2: reads use a read-only connection; profiles and OCR annotations use a separate writer.
# In Railway: ${{Postgres.DATABASE_URL}}. Empty falls back to DATABASE_URL.
TOXICHECK_CATALOG_DATABASE_URL=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OCR_MODE=embedded
# OCR_SERVICE_URL is needed only for OCR_MODE=http.
OCR_SERVICE_URL=
GUEST_SESSION_DAYS=90
ADMIN_SESSION_HOURS=8
ADMIN_IDLE_MINUTES=30
# APP_ENV=production enables Secure __Host- cookies. Use /api on the frontend origin.
# Set FRONTEND_ORIGINS to exact trusted frontend origins. No public admin signup exists.
# Research mode: private persistent storage, never a frontend public directory.
RESEARCH_STORAGE_DIR=.research-photos
RESEARCH_APP_VERSION=local
RESEARCH_PIPELINE_VERSION=embedded-adaptive-v1
