# Backend, SQL and the validated bootstrap catalog; never local credentials or dumps.
**
!toxicheck_catalog.json
!backend/
!backend/Dockerfile
!backend/pyproject.toml
!backend/app/
!backend/app/**
!backend/db/
!backend/db/schema_catalog.sql
!backend/db/migrations/
!backend/db/migrations/*.sql
**/__pycache__/
**/*.pyc
**/.env*
